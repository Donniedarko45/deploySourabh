# Canonical public domain
SITE_URL=https://www.cloudfireitservices.com
# Brevo transactional API key; keep this server-only
BREVO_API_KEY=
# A plain email address verified as a sender in Brevo
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=info@cloudfireitservices.com
# Optional call booking. Only HTTPS Cal.com / Calendly links are accepted.
BOOKING_URL=
# Optional cookie-free Umami analytics. Set before building.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
# Optional Cloudflare Turnstile. Configure both keys together.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
